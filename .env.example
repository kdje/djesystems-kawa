# Firebase Admin SDK:
# Local development: point to a service-account JSON stored OUTSIDE Git.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-service-account.json

# MySQL
MYSQL_ROOT_PASSWORD=CHANGE_ME
MYSQL_USER=kawa
MYSQL_PASSWORD=CHANGE_ME

CUSTOMER_DB_URL=jdbc:mysql://mysql:3306/kawa_customer
WALLET_DB_URL=jdbc:mysql://mysql:3306/kawa_wallet
RETAILER_DB_URL=jdbc:mysql://mysql:3306/kawa_retailer
PARTNER_DB_URL=jdbc:mysql://mysql:3306/kawa_partner

# Partner/POS OAuth2 issuer (separate from Firebase consumer auth)
KAWA_PARTNER_JWT_ISSUER_URI=http://localhost:9090/realms/kawa-partners
